pipeline {
    agent any

    environment {
        LABS = credentials('labcreds')
    }

    stages {
        stage('Build') {
            steps {
                sh 'pipenv --rm || true'
                sh 'pipenv install'
                echo 'Build Successful'
            }
        }

        stage('Test') {
            steps {
                sh 'pipenv run pytest'
                echo 'Test Successful'
            }
        }

        stage('Package') {
            steps {
                sh 'zip -r retailproject.zip .'
                echo 'Package Successful'
            }
        }

        stage('Deploy') {
            steps {
                sh '''
                sshpass -p $LABS_PSW scp -o StrictHostKeyChecking=no \
                retailproject.zip \
                $LABS_USR@g02.itversity.com:/home/itv025615/retailproject
                '''
                echo 'Deployment Successful'
            }
        }
    }
}